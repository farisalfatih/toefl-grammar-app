# ===========================================
# Konfigurasi TOEFL Grammar Practice App
# ===========================================

# --- Authentication ---
# Ganti username dan password sesuai keinginan
AUTH_USERNAME=admin
AUTH_PASSWORD=toefl123

# --- Groq API ---
# Daftar di https://console.groq.com untuk dapatkan API key
GROQ_API_KEY=gsk_your_api_key_here

# --- JWT Secret ---
# Ganti dengan string acak yang panjang (min 32 karakter)
# Bisa generate di: https://randomkeygen.com
JWT_SECRET=ubah-ini-dengan-random-string-yang-panjang
